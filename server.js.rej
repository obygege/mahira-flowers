+// Bangun link WhatsApp untuk 2 mode: wa.me (buka app WA di HP / prompt pilih WA Web di desktop)
+// dan api.whatsapp.com yang khusus dipakai untuk arahkan ke WhatsApp Web di browser desktop.
+function buildWhatsappLinks(text) {
+  return {
+    whatsapp_url: `https://wa.me/${ADMIN_WHATSAPP}?text=${text}`,
+    whatsapp_app_url: `https://api.whatsapp.com/send?phone=${ADMIN_WHATSAPP}&text=${text}`,
+    whatsapp_web_url: `https://web.whatsapp.com/send?phone=${ADMIN_WHATSAPP}&text=${text}`
+  };
+}
