@@ -802,6 +802,100 @@ nav.main-nav a.active {
   color: #948a7c;
 }
 
+/* Testimonials slider (aktif otomatis kalau testimoni > 3) */
+.testimonials-wrap {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: .75rem;
+}
+
+.testimonials.is-slider {
+  display: flex;
+  grid-template-columns: none;
+  gap: 1.5rem;
+  overflow-x: auto;
+  scroll-snap-type: x mandatory;
+  scroll-behavior: smooth;
+  padding: .25rem .25rem 1rem;
+  -webkit-overflow-scrolling: touch;
+  scrollbar-width: thin;
+}
+
+.testimonials.is-slider .testimonial {
+  flex: 0 0 calc(33.333% - 1rem);
+  scroll-snap-align: start;
+}
+
+.testimonials.is-slider::-webkit-scrollbar {
+  height: 6px;
+}
+
+.testimonials.is-slider::-webkit-scrollbar-thumb {
+  background: var(--maroon);
+  border-radius: 3px;
+  opacity: .35;
+}
+
+.testi-nav {
+  box-sizing: border-box;
+  flex: 0 0 auto;
+  width: 42px;
+  height: 42px;
+  border-radius: 50%;
+  border: 1px solid var(--line, #e6ddd0);
+  background: #fff;
+  color: var(--maroon);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 1rem;
+  line-height: 1;
+  padding: 0;
+  box-shadow: 0 6px 16px rgba(58, 42, 42, .12);
+  transition: background .2s ease, color .2s ease, transform .15s ease, box-shadow .2s ease;
+}
+
+.testi-nav i {
+  pointer-events: none;
+}
+
+.testi-nav:hover {
+  background: var(--maroon);
+  border-color: var(--maroon);
+  color: #fff;
+  box-shadow: 0 8px 20px rgba(138, 31, 43, .25);
+}
+
+.testi-nav:active {
+  transform: scale(.92);
+}
+
+.testi-nav[disabled] {
+  opacity: .35;
+  cursor: not-allowed;
+  box-shadow: none;
+}
+
+@media(max-width:900px) {
+  .testimonials.is-slider .testimonial {
+    flex: 0 0 calc(80% - 1rem);
+  }
+}
+
+@media(max-width:520px) {
+  .testimonials.is-slider .testimonial {
+    flex: 0 0 88%;
+  }
+
+  .testi-nav {
+    width: 36px;
+    height: 36px;
+    font-size: .9rem;
+  }
+}
+
 /* Instagram */
 .instagram-title {
   text-align: center;
