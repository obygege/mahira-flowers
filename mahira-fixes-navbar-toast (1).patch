+.mahira-toast-stack {
+  position: fixed;
+  top: 20px;
+  right: 20px;
+  z-index: 99999;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  max-width: 360px;
+  width: calc(100% - 40px);
+  pointer-events: none;
+}
+@media (max-width: 480px) {
+  .mahira-toast-stack { top: 12px; right: 12px; left: 12px; max-width: none; width: auto; }
+}
+.mahira-toast {
+  pointer-events: auto;
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  background: #fff;
+  border-radius: 10px;
+  padding: 14px 16px;
+  box-shadow: 0 10px 30px rgba(30, 20, 10, .18), 0 2px 6px rgba(30, 20, 10, .08);
+  border-left: 4px solid #c9a15a;
+  font-family: 'Montserrat', system-ui, sans-serif;
+  font-size: .92rem;
+  color: #33291f;
+  transform: translateX(120%);
+  opacity: 0;
+  transition: transform .35s cubic-bezier(.34,1.56,.64,1), opacity .35s ease;
+}
+.mahira-toast.show { transform: translateX(0); opacity: 1; }
+.mahira-toast.hide { transform: translateX(120%); opacity: 0; }
+.mahira-toast .mahira-toast-icon {
+  flex-shrink: 0;
+  width: 26px;
+  height: 26px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: .8rem;
+  color: #fff;
+  background: #c9a15a;
+}
+.mahira-toast.success { border-left-color: #3f9142; }
+.mahira-toast.success .mahira-toast-icon { background: #3f9142; }
+.mahira-toast.error { border-left-color: #c0392b; }
+.mahira-toast.error .mahira-toast-icon { background: #c0392b; }
+.mahira-toast.info { border-left-color: #2f77c9; }
+.mahira-toast.info .mahira-toast-icon { background: #2f77c9; }
+.mahira-toast.warning { border-left-color: #d68a1d; }
+.mahira-toast.warning .mahira-toast-icon { background: #d68a1d; }
+.mahira-toast-body { flex: 1; line-height: 1.4; padding-top: 2px; }
+.mahira-toast-close {
+  border: none;
+  background: none;
+  color: #9c9184;
+  cursor: pointer;
+  font-size: .85rem;
+  padding: 2px;
+  line-height: 1;
+}
+.mahira-toast-close:hover { color: #33291f; }
