+    const r = await fetch('/api/categories/'+encodeURIComponent(slug)+'?lang='+encodeURIComponent(customerLang()));
+    const d = await r.json();
+    if(!r.ok) throw Error(d.message);
+    document.title = d.category.name + ' - Mahira Flowers';
+    document.getElementById('title').textContent = d.category.name;
+    document.getElementById('results').innerHTML = d.data.map(p=>productCard(p)).join('') || `<div class="empty">${customerTranslations[customerLang()].category_empty}</div>`;
+  }catch(e){
+    document.getElementById('title').textContent = FIXED_CATEGORIES.find(c=>c.slug===slug)?.name || 'Kategori';
+    document.getElementById('results').innerHTML = '<div class="empty">'+safe(e.message)+'</div>';
+  }
+}
+document.addEventListener('mahira-lang-changed', load);
+load();
+</script>
