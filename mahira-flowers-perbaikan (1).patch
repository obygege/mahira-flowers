+  { slug: 'wedding-property', name: 'Wedding Property' },
+  { slug: 'lainnya', name: 'Lainnya' }
+];
+
+function renderSidebar(activeSlug){
+  const sidebar = document.getElementById('categorySidebar');
+  const links = FIXED_CATEGORIES.map(c =>
+    `<a href="/category/${c.slug}" class="${c.slug===activeSlug?'active':''}">${c.name}</a>`
+  ).join('');
+  sidebar.innerHTML = '<h2>Kategori</h2>' + links;
+}
+
+async function load(){
+  const slug = location.pathname.split('/').pop();
+  renderSidebar(slug);
